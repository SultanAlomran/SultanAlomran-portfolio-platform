FROM node:22-alpine AS build
WORKDIR /app
COPY src/Portfolio.Admin/package*.json ./
RUN npm ci
COPY src/Portfolio.Admin/ ./
RUN npm run build -- --configuration preview
FROM nginx:1.29-alpine
COPY deploy/preview/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/preview/entrypoint.sh /entrypoint.sh
COPY --from=build /app/dist/portfolio.admin/browser /usr/share/nginx/html
RUN chmod +x /entrypoint.sh
EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
