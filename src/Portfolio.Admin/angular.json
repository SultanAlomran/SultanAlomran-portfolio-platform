{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "portfolio.admin": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/portfolio.admin",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": [
              "public/assets/vendors/keenicons/styles.bundle.css",
              "public/assets/css/styles.css",
              "src/styles.css"
            ],
            "scripts": [
              "public/assets/js/core.bundle.js",
              "public/assets/vendors/ktui/ktui.min.js"
            ]
          },
          "configurations": { "production": { "budgets": [{"type":"initial","maximumWarning":"2MB","maximumError":"2.5MB"}], "outputHashing": "all" }, "preview": { "optimization": true, "outputHashing": "all", "fileReplacements": [{ "replace": "src/environments/environment.ts", "with": "src/environments/environment.preview.ts" }] }, "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }, "dev-tunnel": { "optimization": false, "extractLicenses": false, "sourceMap": true, "fileReplacements": [{ "replace": "src/environments/environment.ts", "with": "src/environments/environment.dev-tunnel.ts" }] } },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular-devkit/build-angular:dev-server", "configurations": { "production": { "buildTarget": "portfolio.admin:build:production" }, "development": { "buildTarget": "portfolio.admin:build:development" }, "dev-tunnel": { "buildTarget": "portfolio.admin:build:dev-tunnel", "proxyConfig": "proxy.dev-tunnel.json" } }, "defaultConfiguration": "development" },
        "lint": { "builder": "@angular-eslint/builder:lint", "options": { "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"] } }
      }
    }
  }
}
